# ============================================================
#  Variables de entorno
#  Copiá este archivo como .env.local y completá los valores.
#  .env.local NUNCA se sube a git (ya está en .gitignore).
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Las encontrás en tu proyecto de Supabase:
#   Project Settings → API

# URL del proyecto (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon / public). Puede viajar al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privada (service_role). NUNCA la compartas ni la pongas
# en una variable que empiece con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Tu dominio ──────────────────────────────────────────────
# Con https:// y sin barra al final. Se usa en el sitemap.
# En local podés dejar http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feed de Instagram (opcional) ────────────────────────────
# Sólo si querés mostrar tus últimas fotos en la home.
# El token también se puede cargar desde /admin/ajustes.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ── Node ────────────────────────────────────────────────────
NODE_ENV=development
